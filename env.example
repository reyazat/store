APP_NAME=ecommerce-API
APP_ENV=local
APP_KEY=base64:inkr70bV1hsEzdTUp1wMYyh5KjC1aMWXzSLNE5XYEoA=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

# Locale Settings
LOCALE_COOKIE_ENABLED=true

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=ecommerce
DB_USERNAME=ecommerce
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_EXPIRE_ON_CLOSE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=ecommerce_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ============================================
# IAM Service Configuration (vreyazat/iam-service)
# ============================================

# JWT Configuration
JWT_SECRET=fuxWlBAUNP7pBisKioNhoz1MW72dE0J0u1CKPGHkk43FMQAmxSzA6EiYGcM6ROMQ
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=
JWT_PASSPHRASE=
JWT_ALGO=HS256
JWT_TTL=15
JWT_REFRESH_TTL=43200
JWT_LEEWAY=60
JWT_BLACKLIST_ENABLED=true
JWT_BLACKLIST_GRACE_PERIOD=10

# IAM Password Policy
IAM_PASSWORD_EXPIRY_DAYS=90
IAM_PASSWORD_WARNING_DAYS=7
IAM_PASSWORD_HISTORY_COUNT=5
IAM_PASSWORD_MIN_LENGTH=8
IAM_PASSWORD_MAX_LENGTH=128
IAM_PASSWORD_REQUIRE_UPPERCASE=true
IAM_PASSWORD_REQUIRE_LOWERCASE=true
IAM_PASSWORD_REQUIRE_NUMBERS=true
IAM_PASSWORD_REQUIRE_SYMBOLS=true
IAM_PASSWORD_PREVENT_COMMON=true
IAM_PASSWORD_PREVENT_USER_INFO=true

# IAM Authentication Settings
IAM_THROTTLE_WINDOW=900
IAM_THROTTLE_MAX_ATTEMPTS=5
IAM_THROTTLE_LOCK_ATTEMPTS=10
IAM_THROTTLE_LOCK_DURATION=1800

# IAM Lockout Settings
IAM_LOCKOUT_MAX_ATTEMPTS=10
IAM_LOCKOUT_DURATION_MINUTES=30
IAM_LOCKOUT_PROGRESSIVE=true
IAM_LOCKOUT_AUTO_UNLOCK=true

# CAPTCHA Configuration
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
CAPTCHA_ENABLED=true
CAPTCHA_THRESHOLD_ATTEMPTS=3

# MFA Configuration
IAM_MFA_ENABLED=true
IAM_MFA_ENFORCE_ADMINS=true
IAM_MFA_RECOVERY_CODES=10
IAM_TOTP_ISSUER="${APP_NAME}"
IAM_MFA_TOTP_WINDOW=1
IAM_MFA_BACKUP_CODES=true

# OTP Configuration
IAM_OTP_EMAIL_ENABLED=true
IAM_OTP_EMAIL_EXPIRY=10
IAM_OTP_EMAIL_MAX_ATTEMPTS=5
IAM_OTP_EMAIL_RATE_LIMIT=5

IAM_OTP_SMS_ENABLED=true
IAM_OTP_SMS_EXPIRY=5
IAM_OTP_SMS_MAX_ATTEMPTS=3
IAM_OTP_SMS_RATE_LIMIT=3
SMS_PROVIDER=kavenegar

IAM_OTP_CODE_LENGTH=6
IAM_OTP_NUMERIC_ONLY=true

# Session Configuration
IAM_SINGLE_DEVICE_ONLY=true
IAM_CONCURRENT_SESSIONS=5
IAM_DEVICE_TRACKING=true
IAM_IP_VALIDATION=false
IAM_USER_AGENT_VALIDATION=true

# Security Settings
IAM_ACTIVITY_LOGGING=true
IAM_FAILED_LOGIN_LOGGING=true
IAM_SUSPICIOUS_THRESHOLD=10
IAM_AUTO_LOCK_SUSPICIOUS=true
IAM_IP_WHITELIST_ENABLED=false
IAM_DEVICE_FINGERPRINTING=false
IAM_GEOLOCATION_CHECKING=false

# Rate Limiting
IAM_API_RATE_AUTHENTICATED=60
IAM_API_RATE_GUEST=20
IAM_LOGIN_RATE_ATTEMPTS=5
IAM_LOGIN_RATE_WINDOW=15
IAM_REGISTRATION_RATE=3
IAM_PASSWORD_RESET_RATE=3

# Organization Settings
IAM_REQUIRE_ORG_CONTEXT=true
IAM_DEFAULT_ORG_ROLE=member
IAM_MAX_ORG_MEMBERS=1000
IAM_INVITATION_EXPIRY=72
IAM_MULTI_TENANCY=true

# Features
IAM_REGISTRATION_ENABLED=true
IAM_PASSWORD_RESET_ENABLED=true
IAM_EMAIL_VERIFICATION_REQUIRED=true
IAM_PHONE_VERIFICATION_ENABLED=true
IAM_SOCIAL_LOGIN_ENABLED=false
IAM_REMEMBER_ME_ENABLED=true

# API Configuration
API_VERSION=1.0
MAX_QUERY_LIMIT=100

# Rate Limiting (requests per minute)
API_RATE_LIMIT=60
API_RATE_LIMIT_AUTH=120
API_RATE_LIMIT_GUEST=30

# CORS Configuration
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=*
CORS_MAX_AGE=86400
CORS_SUPPORTS_CREDENTIALS=true


# Localization
LOCALE_DETECTION_HEADER=true
LOCALE_DETECTION_QUERY=true
LOCALE_DETECTION_COOKIE=true

# Security
CMS_XSS_PROTECTION=true
CMS_HTML_PURIFIER=true
CMS_CSRF_PROTECTION=true

# ============================================
# External IFA API Configuration
# ============================================
IFA_API_BASE_URL=http://localhost:8080
IFA_API_USERNAME=
IFA_API_PASSWORD=
IFA_API_TOKEN_TTL=55
IFA_API_TIMEOUT=30
IFA_API_CONNECT_TIMEOUT=10
IFA_API_RETRY_ATTEMPTS=3
IFA_API_RETRY_DELAY=1000
IFA_API_LOGGING_ENABLED=true
IFA_API_LOG_CHANNEL=stack
IFA_API_LOG_BODIES=true
