{
    "name": "vreyazat/iam-service",
    "type": "library",
    "description": "Enterprise IAM system for Laravel with JWT, MFA, RBAC, and multi-tenancy support",
    "keywords": ["laravel", "iam", "authentication", "authorization", "rbac", "jwt", "mfa", "multi-tenancy"],
    "license": "MIT",
    "authors": [
        {
            "name": "VreyAzat",
            "email": "info@vreyazat.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "bacon/bacon-qr-code": "^3.0",
        "kavenegar/laravel": "^1.3",
        "laravel/framework": "^12.0",
        "mews/captcha": "^3.4",
        "php-open-source-saver/jwt-auth": "^2.8",
        "spatie/laravel-activitylog": "^4.10",
        "spatie/laravel-permission": "^6.21",
        "spomky-labs/otphp": "^11.3"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.5.3",
        "mockery/mockery": "^1.6",
        "fakerphp/faker": "^1.23"
    },
    "autoload": {
        "psr-4": {
            "IamApi\\": "src/",
            "IamApi\\Database\\Seeders\\": "src/Database/Seeders/",
            "Database\\Seeders\\": "src/Database/Seeders/"
        },
        "files": [
            "src/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php ../../../vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "IamApi\\Providers\\IamApiServiceProvider"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
