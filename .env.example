APP_NAME=Ecommerce
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

SECURITY_CSP_ENABLED=false

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

LOCALE_COOKIE_ENABLED=true

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecommerce
DB_USERNAME=ecommerce_user
DB_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

CACHE_PREFIX=ecommerce_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ============================================
# IAM Service Configuration
# ============================================
JWT_SECRET=
JWT_ALGO=HS256
JWT_TTL=15
JWT_REFRESH_TTL=43200

IAM_PASSWORD_EXPIRY_DAYS=90
IAM_PASSWORD_MIN_LENGTH=8
IAM_PASSWORD_REQUIRE_UPPERCASE=true
IAM_PASSWORD_REQUIRE_LOWERCASE=true
IAM_PASSWORD_REQUIRE_NUMBERS=true
IAM_PASSWORD_REQUIRE_SYMBOLS=true

IAM_THROTTLE_MAX_ATTEMPTS=5
IAM_LOCKOUT_MAX_ATTEMPTS=10
IAM_LOCKOUT_DURATION_MINUTES=30

CAPTCHA_PROVIDER=turnstile
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
CAPTCHA_ENABLED=true

IAM_MFA_ENABLED=true
IAM_MFA_ENFORCE_ADMINS=true

IAM_REGISTRATION_ENABLED=true
IAM_EMAIL_VERIFICATION_REQUIRED=true

# ============================================
# Payment Configuration (set in Admin Panel)
# ============================================
# Zarinpal merchant ID and card-to-card details
# are stored in the database via Admin > Payment Methods

# ============================================
# CORS
# ============================================
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=*
CORS_SUPPORTS_CREDENTIALS=true
